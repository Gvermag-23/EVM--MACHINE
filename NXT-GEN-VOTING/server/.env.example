# Server-side configuration. Copy to `server/.env` and never commit the real file.

# App
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/nxt_gen_voting
CLIENT_ORIGIN=http://localhost:5173

# API security (used by Phase 2 middleware)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Blockchain (local Hardhat node or public RPC)
RPC_URL=http://127.0.0.1:8545
WS_RPC_URL=ws://127.0.0.1:8545
CONTRACT_ADDRESS=
CHAIN_ID=31337

# Admin wallet for the Voting contract owner (EVM address, server-side only)
ADMIN_WALLET_ADDRESS=
# Operator/deployer private key. SERVER-SIDE ONLY — never expose to the client or UI.
DEPLOYER_PRIVATE_KEY=